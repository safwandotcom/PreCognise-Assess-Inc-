# Environment variables for the Next.js app (this project's root).
# Copy to .env.local for local dev: cp .env.example .env.local
#
# Windows note: if you edit this file (or any .env file) in Notepad, save as
# "UTF-8" not "UTF-8 with BOM" — a leading BOM byte gets read as part of the
# first variable's value and silently breaks it (bit us once with RESEND_API_KEY).
#
# In CI (.github/workflows/ci.yml) these are supplied via GitHub Actions
# repo Settings -> Secrets and variables -> Actions: sensitive values as
# "Secrets", plain URLs/config as "Variables". In production they're set on
# the hosting platform (e.g. Vercel project settings) the same way.

# --- Database (Postgres via Prisma) ---
# Pooled connection string Prisma uses at runtime.
DATABASE_URL=
# Direct (non-pooled) connection string Prisma uses for migrations.
DIRECT_URL=

# --- Auth (Clerk) ---
# clerk.com dashboard -> API Keys. Secret key: server-side only, never expose.
CLERK_SECRET_KEY=
# Publishable key: safe to expose to the browser (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/admin

# --- App secrets ---
# Signs candidate session JWTs. Generate with: openssl rand -base64 32
JWT_SECRET=
# Shared secret checked on internal-only routes called by the socket-server
# (must match the socket-server's own INTERNAL_API_SECRET / equivalent check).
INTERNAL_API_SECRET=
# Bearer token the scheduler cron (api/cron/session-scheduler) checks for.
CRON_SECRET=
# Comma-separated allowlist of admin email addresses permitted to sign in,
# as defense-in-depth on top of Clerk (see #49).
ADMIN_ALLOWED_EMAILS=

# --- Redis (Socket.IO adapter + candidate-broadcast/session-stats cache) ---
REDIS_URL=redis://localhost:6379

# --- Email (Resend) ---
# resend.com dashboard -> API Keys.
RESEND_API_KEY=
# Must be an address on the verified Resend domain (assess.precognise.co).
RESEND_FROM_EMAIL=

# --- URLs ---
# Public base URL of this app (used in emails, redirects, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public URL of the socket-server (see socket-server/.env.example).
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
