generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  LIVE
  PAUSED
  ENDED
}

enum CandidateStatus {
  REGISTERED
  JOINED
  ACTIVE
  COMPLETED
  DISQUALIFIED
}

enum QuestionType {
  mcq
  psychometric
  rating
  image
  short_answer
  long_answer
  true_false
  multi_select
}

model AssessmentSettings {
  id      String  @id @default(cuid())
  ownerId String?

  // Anti-cheat toggles
  antiCheatTabSwitch   Boolean @default(true)
  antiCheatContextMenu Boolean @default(true)
  antiCheatCopyPaste   Boolean @default(true)
  antiCheatScreenshot  Boolean @default(true)
  antiCheatDevTools    Boolean @default(true)

  // Exam behaviour
  speedBonusEnabled Boolean @default(true)
  gracePeriodSec    Int     @default(0)

  // Geo-restriction: comma-separated ISO-3166-1 alpha-2 codes (empty = no restriction)
  geoRestriction String @default("")

  updatedAt DateTime @updatedAt
}

model OrgBranding {
  id            String   @id @default(cuid())
  ownerId       String?
  orgName       String   @default("PreCognise")
  tagline       String   @default("Candidate Assessment")
  logoUrl       String?
  primaryColour String   @default("#3730A3")
  updatedAt     DateTime @updatedAt
}

model Campaign {
  id                         String         @id @default(cuid())
  ownerId                    String?
  name                       String
  status                     CampaignStatus @default(DRAFT)
  joinToken                  String         @unique
  scheduledAt                DateTime?
  autoStart                  Boolean        @default(false)
  startedAt                  DateTime?
  endedAt                    DateTime?
  durationSec                Int            @default(0)
  logoUrl                    String?
  bgColor                    String         @default("#F8FAFC")
  maxCandidates              Int?
  negativeMarking            Boolean        @default(false)
  negativeMarkingValue       Float          @default(0.25)
  gracePeriodMin             Int            @default(10)
  scheduledEnd               DateTime?
  openJoinEnabled            Boolean        @default(false)
  disqualifyOnDuplicateLogin Boolean        @default(true)
  autoDisqualifyOnViolation  Boolean        @default(true)
  antiCheatTabSwitch         Boolean        @default(false)
  tabSwitchLimit             Int            @default(3)
  antiCheatFullscreen        Boolean        @default(false)
  antiCheatCopyPaste         Boolean        @default(false)
  antiCheatRightClick        Boolean        @default(false)
  antiCheatScreenshot        Boolean        @default(false)
  antiCheatDevTools          Boolean        @default(false)
  antiCheatCamera            Boolean        @default(false)
  antiCheatMultiDisplay      Boolean        @default(false)
  antiCheatShuffleQuestions  Boolean        @default(false)
  antiCheatShuffleAnswers    Boolean        @default(false)
  lastBroadcast              String?
  lastBroadcastAt            DateTime?
  completionMessage          String?
  instructionsHtml           String?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  candidates                 Candidate[]
  questions                  Question[]

  @@index([ownerId])
}

model Candidate {
  id                         String          @id @default(cuid())
  accessId                   String
  email                      String
  name                       String
  passwordHash               String
  generatedPassword          String?
  activeToken                String?         @unique
  country                    String?
  status                     CandidateStatus @default(REGISTERED)
  disqualifyReason           String?
  tabSwitchCount             Int             @default(0)
  cameraViolationCount       Int             @default(0)
  multiDisplayViolationCount Int             @default(0)
  otpHash                    String?
  otpExpiresAt               DateTime?
  // Wrong-attempt counter for the *current* otpHash — reset to 0 whenever a
  // new OTP is issued, incremented on each wrong guess. Locks the code (not
  // just the account) after 5 wrong tries, independent of #74's time-window
  // rate limiting, which bounds request rate but not total guesses against
  // one still-valid code.
  otpAttempts                Int             @default(0)
  // PIPEDA consent — set for self-registered (open-join) candidates only,
  // captured at the moment their account was created. Null for
  // admin-imported candidates, who never went through a self-registration
  // form to consent on.
  consentedAt                DateTime?
  consentIp                  String?
  // Set when this candidate's device doesn't support the Fullscreen API at
  // all (iOS Safari on iPhone, most in-app browser webviews) — a platform
  // limitation, not something JS can work around. Fullscreen enforcement is
  // skipped for this candidate rather than trapping them behind an
  // unwinnable "return to fullscreen" prompt; this flag is the record that
  // it happened, surfaced to the admin in the live view and results.
  fullscreenUnsupported      Boolean         @default(false)
  acknowledgedAt             DateTime?
  // Set once the candidate has confirmed camera/fullscreen/single-display
  // access on the pre-waiting-room device-check screen. Deliberately
  // separate from acknowledgedAt (which records "I read the rules and will
  // behave honestly", captured later, right before the exam) — this is
  // specifically "I agreed to be monitored", captured at the moment those
  // permissions were live, and is the documented proof of consent task #26
  // exists for.
  monitoringConsentedAt      DateTime?
  campaignId                 String
  campaign                   Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  responses                  Response[]

  @@unique([accessId, campaignId])
  @@unique([email, campaignId])
}

model Question {
  id             String       @id @default(cuid())
  type           QuestionType
  text           String
  imageUrl       String?
  options        Json
  correctOption  Int?
  correctOptions Int[]        @default([])
  wordLimit      Int?
  timeLimitSec   Int
  basePoints     Int
  speedBonusMax  Int          @default(0)
  orderIndex     Int
  campaignId     String
  campaign       Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  responses      Response[]
}

model Response {
  id             String    @id @default(cuid())
  answer         Json
  score          Int       @default(0)
  needsGrading   Boolean   @default(false)
  gradedAt       DateTime?
  responseTimeMs Int
  createdAt      DateTime  @default(now())

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([candidateId, questionId])
}
