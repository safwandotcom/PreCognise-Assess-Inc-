# Environment variables for socket-server (deployed separately, see railway.json).
# Copy to .env for local dev: cp .env.example .env
#
# In production these are set on the hosting platform (Railway project settings).

PORT=4000

# Must match the Next.js app's JWT_SECRET — candidate session tokens are
# verified here too.
JWT_SECRET=

# CORS origin — the Next.js app's URL.
FRONTEND_URL=http://localhost:3000

# Shared secret sent as x-internal-secret on the disqualify callback to the
# Next.js app's internal API — must match its INTERNAL_API_SECRET.
INTERNAL_API_SECRET=

# Redis, for the Socket.IO adapter (multi-instance pub/sub) and candidate
# state (lib/state.ts). Falls back to redis://localhost:6379 if unset, but
# production must point this at the same Redis instance as the Next.js app.
REDIS_URL=redis://localhost:6379
